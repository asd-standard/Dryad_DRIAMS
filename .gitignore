# Ignore everything
*

# Allow directories (needed so subdirectory contents are even checked)
!*/

# Allow only .md, .ipynb, .rst, .py files
!*.md
!*.ipynb
!*.rst
!*.py
!Makefile

# Repo metadata files
!LICENSE
!CITATION.cff
!requirements.txt
!environment.yml

# And .gitignore itself
!.gitignore

# Local-only snapshot (06d copy of 06b 06-03c), not tracked
06d/
